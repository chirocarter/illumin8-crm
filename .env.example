# Copy to .env.local for local overrides; set these in your host's dashboard when deploying.

# REQUIRED in production — sign-in cookies are signed with this.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Hosted database (Turso). Leave unset to use the local file at data/outreach.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
