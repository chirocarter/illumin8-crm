# Copy to .env.local for local overrides; set these in your host's dashboard when deploying.

# REQUIRED in production — sign-in cookies are signed with this.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Hosted database (Turso). Leave unset to use the local file at data/outreach.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# HMAC secret used to hash AI agent API credentials before storing/comparing.
# Deliberately separate from SESSION_SECRET so the two rotate independently:
# rotating the session secret signs everyone out, and that should not also
# break the agent integration. No fallback — if this is unset, agent
# authentication fails closed and every /api/agent route returns 500.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENT_KEY_SECRET=
